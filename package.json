{
  "name": "lab_1",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "imports": {
    "#config/*": "./src/config/*.js",
    "#schemas/*": "./src/schemas/*.js",
    "#controllers/*": "./src/controllers/*.js",
    "#routes/*": "./src/routes/*.js",
    "#services/*": "./src/services/*.js",
    "#repositories/*": "./src/repositories/*.js",
    "#validators/*": "./src/validators/*.js",
    "#utils/*": "./src/utils/*.js",
    "#data/*": "./data/*.js"
  },
  "description": "",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "predev": "npm run check",
    "dev": "nodemon src/app.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed": "node src/scripts/seed.js",
    "seed:force": "node src/scripts/seed.js --force",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "external": "json-server db.json --port 3001"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/babiakmaria/framework-labs.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/babiakmaria/framework-labs/issues"
  },
  "homepage": "https://github.com/babiakmaria/framework-labs#readme",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "json-server": "^1.0.0-beta.15",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/env": "^5.0.3",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/redis": "^7.2.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/static": "^9.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@fastify/websocket": "^11.2.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "argon2": "^0.44.0",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.7.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.2",
    "fastify-plugin": "^5.1.0",
    "mysql2": "^3.22.3"
  }
}
